{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "2.0.0",
  "permissions": ["downloads", "storage", "unlimitedStorage", "notifications"],
  "icons": { "128": "icons/icon128.png" },
  "action": { "default_title": "__MSG_extName__", "default_popup": "src/popup/popup.html" },
  "background": { "service_worker": "src/background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/page/viewport-patch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/i18n.js",
        "src/shared/transcript.js",
        "src/content/meet-dom.js",
        "src/content/layout.js",
        "src/content/watchdog.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
