{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "2.1.0",
  "minimum_chrome_version": "130",
  "permissions": ["downloads", "storage", "unlimitedStorage", "notifications"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/page/viewport-patch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/i18n.js",
        "src/shared/transcript.js",
        "src/content/meet-dom.js",
        "src/content/layout.js",
        "src/content/watchdog.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
